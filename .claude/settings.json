{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run watch)",
      "Bash(npm test:*)",
      "Bash(npx ng generate:*)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "PowerShell(npm run build)",
      "PowerShell(npm run watch)",
      "PowerShell(npm test:*)",
      "PowerShell(npx ng generate:*)",
      "PowerShell(npx prettier:*)",
      "PowerShell(npx tsc:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  },
  "enableAllProjectMcpServers": false
}
